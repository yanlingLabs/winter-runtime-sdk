{
  "name": "@yanlinglabs/winter-runtime-sdk",
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "description": "One door over the Winter Agent SDK and the official Claude Agent SDK: runtime selection, the official-SDK adapter, the shared session store, the handoff barrier and the cross-runtime messaging router.",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yanlingLabs/winter-runtime-sdk.git"
  },
  "homepage": "https://github.com/yanlingLabs/winter-runtime-sdk",
  "bugs": {
    "url": "https://github.com/yanlingLabs/winter-runtime-sdk/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:packages": "bun run scripts/build-packages.ts",
    "release:pack": "bun run scripts/release-pack.ts",
    "smoke:installed": "bun run scripts/smoke-installed.ts",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "bun test",
    "prepack": "node -e \"if(!/\\bpnpm\\//.test(process.env.npm_config_user_agent||''))throw new Error('pack/publish this package with pnpm. publishConfig.exports is a pnpm-only feature: under npm the override is ignored, so the packed manifest keeps a bun condition pointing at src/ -- which files does not ship -- and the tarball is broken for every Bun consumer while installing fine under Node. See RELEASING.md.')\""
  },
  "publishConfig": {
    "access": "restricted",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "winter": {
    "publish": {
      "npm": true
    }
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.250",
    "@yanlinglabs/winter-agent-sdk": ">=0.0.2 <0.1.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.250",
    "@types/bun": "^1.3.0",
    "@types/node": "^26.4.0",
    "@yanlinglabs/winter-agent-sdk": "link:../winter-agent-sdk/packages/sdk",
    "@yanlinglabs/winter-conformance": "link:../winter-agent-sdk/packages/conformance",
    "@yanlinglabs/winter-provider-conformance": "link:../winter-agent-sdk/packages/provider-conformance",
    "typescript": "^5.9.0"
  }
}
